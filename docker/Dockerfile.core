# Multi-stage Docker build for TraceWeaver C++ Core Engine
FROM ubuntu:24.04 AS build-env

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    g++-14 \
    clang-18 \
    git \
    ninja-build \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# Build with GCC-14 supporting full C++20
RUN cmake -B build -S . -G Ninja \
    -DCMAKE_CXX_COMPILER=g++-14 \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_STANDALONE_TESTS=ON

RUN cmake --build build

# Run unit tests during container build
RUN ./build/core/standalone_all_tests

CMD ["./build/core/standalone_all_tests"]
